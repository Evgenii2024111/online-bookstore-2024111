{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "online-bookstore",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-12",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstore-db",
      "database_id": "b57259e0-5e2b-4d3b-a9b7-1f70be406028"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "w12-rag-vectors",
      "remote": true
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
